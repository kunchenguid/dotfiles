# Safe, cross-machine SSH defaults (macOS). Committed - no secrets here.
# Symlinked to ~/.ssh/dotfiles.config.public by home.nix and Included into
# ~/.ssh/config by the activation script there. Per-host secrets (hostnames,
# IPs, users, ports, identity files) belong in dotfiles.config.private
# instead - see dotfiles.config.private.example and README.md "Private SSH
# hosts".
#
# Colima's own ssh_config is NOT included here; it stays entirely in the
# local, unmanaged ~/.ssh/config so Colima can keep rewriting it freely.

Host github.com
  AddKeysToAgent yes
  IdentitiesOnly yes
  IdentityFile ~/.ssh/id_rsa
  UseKeychain yes

Host *
  AddKeysToAgent yes
  IdentitiesOnly yes
