# Copy this file to config.private in the same directory and fill in your
# real per-host SSH entries. config.private is ignored by Git and merged into
# ~/.ssh/config via home-manager's programs.ssh Include mechanism (home.nix).
#
# Put anything host-specific here: real hostnames/IPs, personal usernames,
# non-default ports, per-server IdentityFile paths. Safe, general defaults
# (github.com, Host * hardening) are managed declaratively in home.nix instead.

Host myserver
  HostName your-server-ip-or-hostname
  User your-username
  IdentityFile ~/.ssh/id_rsa
