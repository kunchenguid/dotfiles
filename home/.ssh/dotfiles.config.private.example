# Copy this file to dotfiles.config.private in the same directory and fill in
# your real per-host SSH entries. dotfiles.config.private is ignored by Git
# and symlinked to ~/.ssh/dotfiles.config.private by home.nix, which Includes
# it into ~/.ssh/config on rebuild.
#
# Put anything host-specific here: real hostnames/IPs, personal usernames,
# non-default ports, per-server IdentityFile paths. Safe, general identity
# defaults live in the committed dotfiles.config.public fragment instead.

Host myserver
  HostName your-server-ip-or-hostname
  User your-username
  IdentityFile ~/.ssh/id_rsa
